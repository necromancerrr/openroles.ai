{
  "name": "openroles",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.6.0"
  },
  "description": "Internship & new-grad tracker — the Grove & Sky design system. A scanning surface where age is the signal: a baby-blue freshness rail, liquid-glass chrome, light and dark.",
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run snapshot; node --experimental-strip-types scripts/fetch-logos.ts --budget=300 || echo '[prebuild] logo fetch skipped — building without it'",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'lib/*.test.ts'",
    "snapshot": "tsx scripts/build-snapshot.ts",
    "ingest:sources": "node --experimental-strip-types scripts/generate-sources.ts",
    "eval:classifier": "node --experimental-strip-types scripts/eval-classifier.ts",
    "audit:logos": "node --experimental-strip-types scripts/audit-logo-domains.ts",
    "fetch:logos": "node --experimental-strip-types scripts/fetch-logos.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@vercel/analytics": "^2.0.1",
    "next": "^16.3.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.3.0",
    "tsx": "^4.20.6",
    "typescript": "5.7.3"
  }
}
